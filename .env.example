# 랜딩페이지 링크 설정. 이 파일을 .env 로 복사해서 값을 채운다.
# 모두 빌드할 때 HTML 에 그대로 들어가는 공개 주소다. 비밀 값(API 키 등)은 넣지 않는다.

# canonical, og:url, sitemap.xml, robots.txt 의 기준 주소 (끝에 / 없이)
SITE_URL=https://myfinsight.vercel.app

# 웹에 올린 MyFinSight 앱 주소 (있을 때만). 넣으면 시작 버튼이 "내 아이디어 검증하기"로 그 주소를 연다.
# 지금 MyFinSight 는 내려받아 켜는 프로그램이라 비워 둔다 → 시작 버튼은 "MyFinSight 내려받기"(내려받기 섹션)
NEXT_PUBLIC_APP_URL=

# 헤더, 마지막 CTA, 바닥글의 GitHub 링크. 내려받기 링크(Releases)도 이 저장소를 기준으로 만든다
NEXT_PUBLIC_REPO_URL=https://github.com/sumb-10/MyFinSight

# ── 내려받기 판 (lib/release.ts). 빌드할 때 GitHub Releases 에서 읽고, 아래 값이 있으면 그것을 쓴다 ──
# 판 번호. 비우거나 latest 면 가장 최근 판(시험판 포함). 고정하려면 0.1.1 처럼
RELEASE_VERSION=
# 공개일 YYYY-MM-DD (비우면 GitHub 게시일)
RELEASE_DATE=
# 시험판 표시 true/false (비우면 GitHub 표시)
RELEASE_PRERELEASE=
# 「이 버전에서 바뀐 점」 링크 (비우면 그 판의 Releases 페이지)
RELEASE_NOTES_URL=
# 「배포판 안내」 링크 (비우면 그 판의 packaging/source-zip/README.md)
RELEASE_GUIDE_URL=
