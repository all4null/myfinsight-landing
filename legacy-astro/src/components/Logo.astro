---
/** 앱 사이드바의 로고(파란 사각형 + 상승선 아이콘 + 글자)를 그대로 옮겼다. 아이콘 선은 lucide "trending-up" (ISC). */
interface Props {
  size?: number;
  tone?: "dark" | "light";
  class?: string;
}
const { size = 30, tone = "dark", class: className = "" } = Astro.props;
---

<span class:list={["inline-flex items-center gap-2.5", className]}>
  <svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <rect width="32" height="32" rx="8" fill={tone === "dark" ? "#1d4ed8" : "#ffffff"}></rect>
    <g
      fill="none"
      stroke={tone === "dark" ? "#ffffff" : "#1d4ed8"}
      stroke-width="2.2"
      stroke-linecap="round"
      stroke-linejoin="round"
      transform="translate(5 5) scale(0.917)"
    >
      <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline>
      <polyline points="16 7 22 7 22 13"></polyline>
    </g>
  </svg>
  <span class:list={["text-[19px] font-bold tracking-[-0.02em]", tone === "dark" ? "text-ink" : "text-white"]}>
    MyFinSight
  </span>
</span>
