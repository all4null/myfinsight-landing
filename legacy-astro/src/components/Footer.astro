---
import Logo from "./Logo.astro";
import GithubMark from "./GithubMark.astro";
import { nav, site } from "../config/site";
const year = new Date().getFullYear();
---

<footer class="bg-navy text-[#c9d6e8]">
  <div class="wrap grid gap-10 py-14 md:grid-cols-12">
    <div class="md:col-span-6">
      <Logo tone="light" />
      <p class="mt-5 max-w-[30rem] text-[15px] leading-relaxed">
        MyFinSight는 투자 아이디어를 과거 자료로 확인해 보는 분석 도구입니다. 투자 자문이나 매매 서비스를 제공하지
        않으며, 리포트의 과거 성과는 앞으로의 수익을 뜻하지 않습니다.
      </p>
    </div>
    <nav class="md:col-span-3 md:col-start-8" aria-label="바닥글 메뉴">
      <ul class="flex flex-col gap-1">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="inline-flex min-h-11 items-center text-[15px] hover:text-white">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    {
      site.repoUrl && (
        <div class="md:col-span-2">
          <a href={site.repoUrl} class="inline-flex min-h-11 items-center gap-2 text-[15px] hover:text-white" rel="noopener">
            <GithubMark size={16} />
            GitHub
          </a>
        </div>
      )
    }
  </div>
  <div class="border-t border-white/10">
    <p class="wrap py-6 text-[13px] text-[#8fa3bf]">© {year} MyFinSight</p>
  </div>
</footer>
