---
/**
 * 리포트 보는 법 둘러보기. 앱의 튜토리얼(Front/src/features/tutorial: Coachmark.tsx, steps.ts)을 랜딩 안으로 옮겼다.
 * - 앱은 페이지 전체를 어둡게 하고 스크롤을 잠그지만, 랜딩에서는 앱 창 안에서만 움직인다.
 *   리포트 내용을 translateY 로 옮겨 대상을 창 가운데로 가져오고, 스포트라이트(그림자 상자)와 말풍선이 따라간다.
 * - 화면에 들어오면 자동 재생, 사용자가 조작하면 자동 재생을 멈춘다. 동작 줄이기 설정이면 자동 재생하지 않는다.
 * - 스크립트가 없으면 리포트 화면과 단계 목록이 그대로 보인다.
 */
import AppFrame from "../product/AppFrame.astro";
import TourReport from "../product/TourReport.astro";

// 문구: 앱 tutorial/steps.ts (용어 설명 단계는 랜딩 화면에 맞게 다듬음)
const steps = [
  {
    target: "verdict",
    title: "선택된 전략",
    body: "개요 맨 위 줄에 이번 분석이 고른 전략과 분석 기준일, 백테스트 기간이 있습니다. 선택 이유를 누르면 왜 이 전략을 골랐는지 볼 수 있습니다.",
  },
  {
    target: "past",
    title: "백테스트 핵심 성과",
    body: "그래프는 이 전략을 과거에 따랐다면 수익률이 어떻게 변했을지를 비교지수와 함께 보여 줍니다. 옆에는 연평균 수익률과 최대낙폭이 있습니다.",
  },
  {
    target: "term-help",
    title: "용어 설명",
    body: "용어 옆 ? 를 누르면 지금처럼 짧은 설명이 뜹니다. 위쪽 투자 용어 설명에서는 리포트에 나온 용어를 한곳에서 찾아볼 수 있습니다.",
  },
  {
    target: "composition",
    title: "종목 구성",
    body: "어떤 종목을 어떤 비중으로 담는지 한눈에 보여 줍니다. 막대 길이가 비중입니다.",
  },
  {
    target: "allocation-list",
    title: "종목별 투자 금액",
    body: "종목마다 내 투자금에서 얼마를 넣는지(목표 배분액)를 보여 줍니다.",
  },
  {
    target: "details",
    title: "자세한 분석",
    body: "선택 이유, 비중이 정해진 과정, 기업별 근거, 과거 성과와 내 조건 점검, 시장·뉴스 분석이 들어 있습니다. 눌러서 펼치고, 위쪽 탭을 눌러도 바로 열립니다.",
  },
  {
    target: "paper-start",
    title: "모의투자로 지켜보기",
    body: "마음에 드는 리포트라면 모의투자 시작으로 실제 돈 없이 이 구성을 따라가 볼 수 있습니다.",
  },
];
---

<section id="tour" class="py-20 md:py-28" aria-labelledby="tour-title">
  <div class="wrap">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <h2 id="tour-title" class="h-section">리포트 보는 법, 화면을 따라가며 익히세요</h2>
      </div>
      <p class="lead lg:col-span-5">
        앱에 들어 있는 ‘리포트 보는 법 둘러보기’를 그대로 옮겼습니다. 리포트의 각 부분을 차례로 비추며 무엇을
        읽으면 되는지 알려 줍니다.
      </p>
    </div>

    <div class="tour mt-12" data-tour-root>
      <AppFrame title="분석 리포트 · 둘러보기" active="reports">
        <div class="tour-viewport relative overflow-hidden" data-tour-viewport>
          <div class="tour-content" data-tour-content>
            <TourReport />
          </div>
          <div class="tour-spot" data-tour-spot aria-hidden="true"></div>
          <div class="tour-pop tour-pop--inside" data-tour-pop-inside></div>
        </div>
      </AppFrame>

      <!-- 말풍선: 넓은 화면에서는 창 안(스크립트가 옮김), 좁은 화면에서는 창 아래 -->
      <div class="tour-pop mt-4" data-tour-pop role="region" aria-label="둘러보기 안내" hidden>
        <div class="flex items-center justify-between gap-3">
          <p class="num text-[13px] font-bold text-brand"><span class="sr-only">단계 </span><span data-tour-n>1</span>/{steps.length}</p>
          <button type="button" class="tour-icon-btn" data-tour-play aria-pressed="false">
            <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true" data-icon-pause><rect x="3" y="2.5" width="3.4" height="11" rx="1" fill="currentColor"></rect><rect x="9.6" y="2.5" width="3.4" height="11" rx="1" fill="currentColor"></rect></svg>
            <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true" data-icon-play class="hidden"><path d="M4 2.8v10.4a.8.8 0 0 0 1.2.7l8.4-5.2a.8.8 0 0 0 0-1.4L5.2 2.1A.8.8 0 0 0 4 2.8Z" fill="currentColor"></path></svg>
            <span data-tour-play-label>일시정지</span>
          </button>
        </div>
        <div aria-live="off" data-tour-live>
          <p class="mt-1.5 text-[17px] font-bold tracking-[-0.01em]" data-tour-title>{steps[0].title}</p>
          <p class="mt-1.5 text-[14.5px] leading-relaxed text-ink-2" data-tour-body>{steps[0].body}</p>
        </div>
        <div class="tour-progress mt-4" aria-hidden="true"><span data-tour-bar></span></div>
        <div class="mt-3 flex items-center justify-between gap-2">
          <button type="button" class="tour-text-btn" data-tour-restart>처음부터</button>
          <div class="flex gap-2">
            <button type="button" class="tour-btn tour-btn--ghost" data-tour-prev>이전</button>
            <button type="button" class="tour-btn tour-btn--primary" data-tour-next>다음</button>
          </div>
        </div>
      </div>

      <ol class="tour-steps mt-6" data-tour-steps>
        {
          steps.map((s, i) => (
            <li>
              <button type="button" class="tour-step" data-tour-go={i} aria-current={i === 0 ? "step" : undefined}>
                <span class="num tour-step-n">{i + 1}</span>
                <span class="tour-step-t">{s.title}</span>
                <span class="tour-step-bar" aria-hidden="true" />
              </button>
              <p class="tour-step-body">{s.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
  <script type="application/json" data-tour-steps-json set:html={JSON.stringify(steps)} />
</section>

<style>
  .tour-viewport {
    height: 560px;
    background: #f8fafc;
  }
  @media (max-width: 767px) {
    .tour-viewport {
      height: 480px;
    }
  }
  .tour-content {
    will-change: transform;
    transition: transform 650ms var(--ease-out);
  }

  /* 스포트라이트: 주변을 거대한 그림자로 어둡게 하고 대상 자리만 남긴다 */
  .tour-spot {
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    border-radius: 14px;
    box-shadow:
      0 0 0 2px #60a5fa,
      0 0 0 9999px rgb(15 23 42 / 0.5);
    pointer-events: none;
    opacity: 0;
    transition:
      top 650ms var(--ease-out),
      left 650ms var(--ease-out),
      width 650ms var(--ease-out),
      height 650ms var(--ease-out),
      opacity 300ms ease;
  }
  [data-tour-root][data-ready] .tour-spot {
    opacity: 1;
  }

  /* 말풍선 */
  .tour-pop {
    border: 1px solid var(--color-line);
    border-radius: 14px;
    background: #fff;
    padding: 18px 20px;
    box-shadow: 0 18px 40px -18px rgb(15 27 45 / 0.4);
  }
  .tour-pop--inside {
    display: none;
  }
  [data-tour-root][data-inside] .tour-pop--inside {
    display: block;
    position: absolute;
    top: 0;
    left: 0;
    width: 320px;
    padding: 0;
    border: 0;
    background: none;
    box-shadow: none;
    transition:
      transform 650ms var(--ease-out),
      opacity 250ms ease;
  }
  [data-tour-root][data-inside] .tour-pop--inside > .tour-pop {
    margin: 0;
  }

  .tour-progress {
    height: 3px;
    border-radius: 999px;
    background: var(--color-mist);
    overflow: hidden;
  }
  .tour-progress > span {
    display: block;
    height: 100%;
    width: 0;
    background: var(--color-brand-600);
  }
  .tour-btn {
    min-height: 40px;
    padding: 0 14px;
    border-radius: var(--radius-ui);
    font-size: 14px;
    font-weight: 600;
    transition:
      background-color 150ms ease,
      border-color 150ms ease;
  }
  .tour-btn--primary {
    background: var(--color-brand);
    color: #fff;
  }
  .tour-btn--primary:hover {
    background: #1a44be;
  }
  .tour-btn--ghost {
    border: 1px solid var(--color-line-strong);
    color: var(--color-ink);
  }
  .tour-btn--ghost:hover:not(:disabled) {
    border-color: var(--color-ink-3);
  }
  .tour-btn:disabled {
    opacity: 0.4;
    cursor: default;
  }
  .tour-text-btn {
    min-height: 40px;
    padding: 0 4px;
    font-size: 14px;
    font-weight: 600;
    color: var(--color-ink-3);
  }
  .tour-text-btn:hover {
    color: var(--color-ink);
  }
  .tour-icon-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 32px;
    padding: 0 10px;
    border-radius: 999px;
    border: 1px solid var(--color-line);
    font-size: 12.5px;
    font-weight: 600;
    color: var(--color-ink-2);
  }
  .tour-icon-btn:hover {
    border-color: var(--color-ink-3);
  }

  /* 단계 목록: 스크립트가 없으면 설명까지 보이는 목록, 있으면 진행 표시가 붙은 단계 버튼 줄 */
  .tour-steps {
    display: grid;
    gap: 12px;
  }
  .tour-step {
    display: flex;
    align-items: baseline;
    gap: 10px;
    width: 100%;
    text-align: left;
    font-weight: 600;
    position: relative;
  }
  .tour-step-n {
    color: var(--color-brand);
  }
  .tour-step-body {
    margin-top: 4px;
    padding-left: 22px;
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-ink-2);
  }
  .tour-step-bar {
    display: none;
  }
  [data-tour-root][data-ready] .tour-steps {
    display: none;
  }
  @media (min-width: 1024px) {
    [data-tour-root][data-ready] .tour-steps {
      display: grid;
      grid-template-columns: repeat(7, minmax(0, 1fr));
      gap: 8px;
    }
    [data-tour-root][data-ready] .tour-step-body {
      display: none;
    }
    [data-tour-root][data-ready] .tour-step {
      flex-direction: column;
      gap: 2px;
      min-height: 64px;
      padding: 12px 2px 0;
      border-top: 2px solid var(--color-line);
      font-size: 14px;
      color: var(--color-ink-3);
    }
    [data-tour-root][data-ready] .tour-step-n {
      color: inherit;
    }
    [data-tour-root][data-ready] .tour-step[aria-current="step"] {
      color: var(--color-ink);
    }
    [data-tour-root][data-ready] .tour-step[aria-current="step"] .tour-step-n {
      color: var(--color-brand);
    }
    [data-tour-root][data-ready] .tour-step:hover {
      color: var(--color-ink);
    }
    [data-tour-root][data-ready] .tour-step-bar {
      display: block;
      position: absolute;
      top: -2px;
      left: 0;
      height: 2px;
      width: 0;
      background: var(--color-brand);
    }
    [data-tour-root][data-ready] .tour-step[data-done] .tour-step-bar {
      width: 100%;
    }
  }
</style>

<script>
  type Step = { target: string; title: string; body: string };

  const root = document.querySelector<HTMLElement>("[data-tour-root]");
  const json = document.querySelector<HTMLScriptElement>("[data-tour-steps-json]");
  if (root && json) {
    const steps: Step[] = JSON.parse(json.textContent || "[]");
    const vp = root.querySelector<HTMLElement>("[data-tour-viewport]")!;
    const content = root.querySelector<HTMLElement>("[data-tour-content]")!;
    const spot = root.querySelector<HTMLElement>("[data-tour-spot]")!;
    const pop = root.querySelector<HTMLElement>("[data-tour-pop]")!;
    const insideSlot = root.querySelector<HTMLElement>("[data-tour-pop-inside]")!;
    const outsideAnchor = pop.nextElementSibling; // 단계 목록 앞으로 되돌릴 자리
    const $ = <T extends HTMLElement>(s: string) => pop.querySelector<T>(s)!;
    const nEl = $("[data-tour-n]"), titleEl = $("[data-tour-title]"), bodyEl = $("[data-tour-body]");
    const live = $("[data-tour-live]"), bar = $("[data-tour-bar]");
    const prevBtn = $<HTMLButtonElement>("[data-tour-prev]"), nextBtn = $<HTMLButtonElement>("[data-tour-next]");
    const playBtn = $<HTMLButtonElement>("[data-tour-play]"), restartBtn = $<HTMLButtonElement>("[data-tour-restart]");
    const stepBtns = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-tour-go]"));
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");

    const DWELL = 5200; // 한 단계에 머무는 시간
    const PAD = 6;
    let index = 0;
    let playing = false;
    let userStopped = reduce.matches; // 사용자가 멈췄거나 동작 줄이기면 자동 재생하지 않는다
    let inView = false;
    let timer = 0;

    const target = (i: number) => content.querySelector<HTMLElement>(`[data-tour="${steps[i].target}"]`);

    /** 대상의 자리(내용 기준 좌표). 열린 도움말이 있으면 함께 감싼다 */
    const boxOf = (el: HTMLElement) => {
      const c = content.getBoundingClientRect();
      const r = el.getBoundingClientRect();
      let top = r.top, left = r.left, right = r.right, bottom = r.bottom;
      const tip = el.matches("[data-open]") ? el.querySelector<HTMLElement>(".tr-tip")?.getBoundingClientRect() : null;
      if (tip) {
        top = Math.min(top, tip.top); left = Math.min(left, tip.left);
        right = Math.max(right, tip.right); bottom = Math.max(bottom, tip.bottom);
      }
      return { top: top - c.top, left: left - c.left, width: right - left, height: bottom - top };
    };

    const placePopover = () => {
      const inside = vp.clientWidth >= 620;
      root.toggleAttribute("data-inside", inside);
      if (inside && pop.parentElement !== insideSlot) insideSlot.appendChild(pop);
      if (!inside && pop.parentElement === insideSlot) root.insertBefore(pop, outsideAnchor);
      pop.classList.toggle("mt-4", !inside);
      return inside;
    };

    const layout = () => {
      const el = target(index);
      if (!el) return;
      const inside = placePopover();
      const b = boxOf(el);
      const vh = vp.clientHeight;
      const vw = vp.clientWidth;
      const popH = inside ? pop.offsetHeight + 16 : 0;
      const maxOff = Math.max(0, content.scrollHeight - vh);
      // 말풍선이 창 안에 있으면 대상과 말풍선이 함께 들어오게 대상을 조금 위로
      const want = b.top - Math.max(20, (vh - b.height - popH) / 2);
      const off = Math.max(0, Math.min(maxOff, want));
      content.style.transform = `translateY(${-off}px)`;

      const top = b.top - off;
      Object.assign(spot.style, {
        top: `${top - PAD}px`,
        left: `${b.left - PAD}px`,
        width: `${b.width + PAD * 2}px`,
        height: `${b.height + PAD * 2}px`,
      });

      if (inside) {
        const w = Math.min(320, vw - 32);
        insideSlot.style.width = `${w}px`;
        const ph = pop.offsetHeight;
        const below = top + b.height + PAD + 12;
        const above = top - PAD - 12 - ph;
        let y = below + ph <= vh - 12 ? below : above >= 12 ? above : vh - ph - 12;
        let x = Math.min(Math.max(16, b.left), vw - w - 16);
        // 아래·위 모두 공간이 없어 대상과 겹치면 옆으로 비킨다
        if (y === vh - ph - 12 && b.left + b.width + 12 + w <= vw - 12) x = b.left + b.width + 12;
        insideSlot.style.transform = `translate(${x}px, ${Math.max(12, y)}px)`;
      }
    };

    const setProgress = (ms: number) => {
      bar.style.transition = "none";
      bar.style.width = "0%";
      const cur = stepBtns[index]?.querySelector<HTMLElement>(".tour-step-bar");
      stepBtns.forEach((b, i) => {
        const s = b.querySelector<HTMLElement>(".tour-step-bar");
        if (!s) return;
        s.style.transition = "none";
        s.style.width = i < index ? "100%" : "0%";
      });
      if (!ms) return;
      void bar.offsetWidth;
      bar.style.transition = `width ${ms}ms linear`;
      bar.style.width = "100%";
      if (cur) {
        void cur.offsetWidth;
        cur.style.transition = `width ${ms}ms linear`;
        cur.style.width = "100%";
      }
    };

    const show = (i: number, announce: boolean) => {
      // 떠나는 단계에서 연 도움말은 닫는다
      content.querySelectorAll("[data-open]").forEach((x) => x.removeAttribute("data-open"));
      index = (i + steps.length) % steps.length;
      const s = steps[index];
      if (s.target === "term-help") target(index)?.setAttribute("data-open", "");
      live.setAttribute("aria-live", announce ? "polite" : "off");
      nEl.textContent = String(index + 1);
      titleEl.textContent = s.title;
      bodyEl.textContent = s.body;
      prevBtn.disabled = index === 0;
      nextBtn.textContent = index === steps.length - 1 ? "마치기" : "다음";
      stepBtns.forEach((b, k) => {
        if (k === index) b.setAttribute("aria-current", "step");
        else b.removeAttribute("aria-current");
      });
      requestAnimationFrame(layout);
    };

    const schedule = () => {
      window.clearTimeout(timer);
      if (!playing) { setProgress(0); return; }
      setProgress(DWELL);
      timer = window.setTimeout(() => {
        if (index === steps.length - 1) { setPlaying(false); return; } // 한 바퀴 돌면 멈춘다
        show(index + 1, false);
        schedule();
      }, DWELL);
    };

    const setPlaying = (on: boolean) => {
      playing = on;
      playBtn.setAttribute("aria-pressed", String(!on));
      playBtn.querySelector("[data-icon-pause]")?.classList.toggle("hidden", !on);
      playBtn.querySelector("[data-icon-play]")?.classList.toggle("hidden", on);
      const label = playBtn.querySelector("[data-tour-play-label]");
      if (label) label.textContent = on ? "일시정지" : "자동 재생";
      schedule();
    };

    const userGo = (i: number) => {
      userStopped = true;
      setPlaying(false);
      show(i, true);
    };

    prevBtn.addEventListener("click", () => userGo(index - 1));
    nextBtn.addEventListener("click", () => (index === steps.length - 1 ? userGo(0) : userGo(index + 1)));
    restartBtn.addEventListener("click", () => {
      show(0, true);
      if (!reduce.matches) { userStopped = false; setPlaying(true); }
    });
    playBtn.addEventListener("click", () => {
      userStopped = playing;
      if (!playing && index === steps.length - 1) show(0, false);
      setPlaying(!playing);
    });
    stepBtns.forEach((b) => b.addEventListener("click", () => userGo(Number(b.dataset.tourGo))));
    root.addEventListener("keydown", (e) => {
      if ((e.target as HTMLElement).closest("input, textarea")) return;
      if (e.key === "ArrowRight") { e.preventDefault(); userGo(Math.min(index + 1, steps.length - 1)); }
      if (e.key === "ArrowLeft") { e.preventDefault(); userGo(Math.max(index - 1, 0)); }
    });

    // 화면에 들어오면 자동 재생, 벗어나면 멈춤 (사용자가 직접 멈췄다면 다시 켜지 않는다)
    new IntersectionObserver(
      ([entry]) => {
        inView = entry.isIntersecting;
        if (inView && !userStopped && !playing) setPlaying(true);
        if (!inView && playing) { setPlaying(false); }
      },
      { threshold: 0.45 },
    ).observe(vp);
    document.addEventListener("visibilitychange", () => {
      if (document.hidden && playing) setPlaying(false);
    });

    window.addEventListener("resize", () => requestAnimationFrame(layout));
    pop.hidden = false;
    root.setAttribute("data-ready", "");
    show(0, false);
    setPlaying(false);
  }
</script>
