---
import AppFrame from "../product/AppFrame.astro";
import ReportOverview from "../product/ReportOverview.astro";
import { startCta } from "../../config/site";
import { metrics, pct, pctPlain } from "../../data/example";
---

<section class="relative overflow-hidden pt-10 pb-16 md:pt-16 lg:pb-24" aria-labelledby="hero-title">
  <div class="wrap grid items-start gap-10 lg:grid-cols-12 lg:gap-8">
    <div class="hero-text lg:col-span-6 lg:pt-10">
      <h1 id="hero-title" class="h-display hero-h1">말로 적은 아이디어를<br /> 근거 있는 포트폴리오로</h1>
      <p class="lead mt-6 max-w-[34rem]">
        MyFinSight는 내 투자조건과 아이디어로 종목을 고르고 비중을 계산한 뒤, 과거 데이터로 성과와 위험을
        확인한 리포트를 만듭니다. 실제 매매는 하지 않습니다.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href={startCta.href} class="btn btn-primary" {...startCta.external ? { rel: "noopener" } : {}}>{startCta.label}</a>
        <a href="#tour" class="btn btn-secondary">리포트 둘러보기</a>
      </div>
      <dl class="mt-10 grid max-w-[34rem] grid-cols-2 gap-x-6 gap-y-4 border-t border-line pt-6 text-[15px]">
        <div>
          <dt class="text-ink-3">분석 대상</dt>
          <dd class="mt-0.5 font-semibold">
            <span class="whitespace-nowrap">S&amp;P 500,</span>{" "}<span class="whitespace-nowrap">NASDAQ-100,</span>{" "}<span
              class="whitespace-nowrap">KOSPI 200</span
            >{" "}구성종목
          </dd>
        </div>
        <div>
          <dt class="text-ink-3">검증 방법</dt>
          <dd class="mt-0.5 font-semibold">거래 비용과 리밸런싱을 반영한 백테스트</dd>
        </div>
      </dl>
    </div>

    <div class="hero-art relative lg:col-span-6">
      <div class="art-ground relative h-[340px] overflow-hidden rounded-[18px] border border-line sm:h-[440px] lg:h-[600px]">
        <div class="hero-window absolute top-6 left-5 w-[560px] sm:top-10 sm:left-10 sm:w-[720px] lg:top-14 lg:left-12 lg:w-[880px]">
          <AppFrame title="분석 리포트" active="reports">
            <ReportOverview />
          </AppFrame>
        </div>
      </div>

      <aside
        class="hero-card absolute -bottom-6 left-4 hidden w-[300px] rounded-xl border border-line bg-white p-4 shadow-[0_18px_40px_-18px_rgb(15_27_45/0.35)] sm:block lg:-left-8"
        aria-label="예시 리포트의 조건 점검 결과"
      >
        <p class="flex items-center justify-between text-[13px] font-semibold">
          내 투자조건 점검
          <span class="rounded-[4px] bg-mist px-1.5 py-0.5 text-[11px] font-semibold text-ink-3">예시</span>
        </p>
        <p class="mt-3 flex items-center justify-between gap-3 text-[14px]">
          과거 최대낙폭
          <span class="num font-bold">{pct(metrics.mddStrategy)}</span>
        </p>
        <p class="mt-1 flex items-center justify-between gap-3 text-[14px]">
          손실 감내 수준
          <span class="num font-bold">{pctPlain(metrics.lossTolerance, 0)}</span>
        </p>
        <p class="mt-3 flex items-start gap-2 rounded-lg bg-warn-50 px-3 py-2.5 text-[13px] leading-snug text-[#6b4103]">
          <span class="pill shrink-0 text-[11px] text-warn">주의</span>
          과거 하락 폭이 정해 둔 손실 감내 수준보다 컸습니다.
        </p>
      </aside>
    </div>
  </div>
</section>

<style>
  .hero-h1 {
    font-size: clamp(2.25rem, 1.2rem + 3.6vw, 3.5rem);
  }
  .art-ground {
    background-color: #eef2f7;
    background-image: repeating-linear-gradient(
      to bottom,
      transparent 0,
      transparent 31px,
      rgb(19 41 74 / 0.06) 31px,
      rgb(19 41 74 / 0.06) 32px
    );
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-window {
      animation: rise 700ms var(--ease-out) 120ms both;
    }
    .hero-card {
      animation: rise 600ms var(--ease-out) 420ms both;
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }
</style>
