---
/** 리포트 상세의 "개요" 탭 재현 (앱 report/Dashboard.tsx 구조: 전략 정보 띠 → 백테스트 핵심 성과 → 종목 구성) */
import LineChart from "./LineChart.astro";
import { scenario, metrics, pct, pctPlain } from "../../data/example";

interface Props {
  showHoldings?: boolean;
}
const { showHoldings = true } = Astro.props;
const tabs = ["개요", "종목 선정", "과거 성과", "시장·뉴스", "요청·주의·자료"];
---

<div class="ro px-4 pt-4 pb-5 text-[#0f172a]">
  <div class="ro-head flex flex-col gap-3">
    <div class="min-w-0">
      <p class="text-[11px] font-bold tracking-[0.08em] text-[#1d4ed8]">분석 리포트</p>
      <p class="mt-1 text-[19px] leading-snug font-bold tracking-[-0.02em]">{scenario.name}</p>
    </div>
    <div class="ro-actions flex gap-1.5" aria-hidden="true">
      <span class="rounded-lg bg-[#1d4ed8] px-3 py-1.5 text-[12px] font-semibold text-white">모의투자 시작</span>
      <span class="rounded-lg border border-[#cbd5e1] bg-white px-3 py-1.5 text-[12px] font-semibold text-[#1d4ed8]">조건 수정 요청</span>
    </div>
  </div>

  <div class="mt-3 flex gap-4 overflow-hidden border-b border-[#e2e8f0] text-[12.5px] whitespace-nowrap" aria-hidden="true">
    {tabs.map((t, i) => <span class:list={["pb-2", i === 0 ? "border-b-2 border-[#1d4ed8] font-semibold text-[#1d4ed8]" : "text-[#475569]"]}>{t}</span>)}
  </div>

  <div class="app-card mt-3 grid grid-cols-2 gap-x-4 gap-y-2 px-3.5 py-2.5 text-[11.5px] ro-strip">
    <div>
      <p class="text-[#56667c]">선택된 전략</p>
      <p class="font-semibold">{scenario.strategy}</p>
    </div>
    <div>
      <p class="text-[#56667c]">판단</p>
      <p><span class="pill text-[11px] text-warn">{scenario.verdict}</span></p>
    </div>
    <div>
      <p class="text-[#56667c]">분석 기준일</p>
      <p class="num">{scenario.asOf}</p>
    </div>
    <div>
      <p class="text-[#56667c]">백테스트 기간</p>
      <p class="num">{scenario.period}</p>
    </div>
  </div>

  <div class="app-card mt-3 overflow-hidden">
    <p class="border-b border-[#e2e8f0] bg-[#f8fafc] px-3.5 py-2 text-[13px] font-bold">백테스트 핵심 성과</p>
    <div class="ro-perf grid gap-3 p-3.5">
      <div class="min-w-0">
        <p class="mb-2 text-[12px] font-semibold">누적 수익률</p>
        <LineChart height={150} />
      </div>
      <div class="flex flex-col gap-2.5">
        <div class="rounded-[10px] border border-[#e2e8f0] p-3">
          <p class="text-[12px] font-semibold">연평균 수익률(CAGR)</p>
          <div class="mt-1.5 grid grid-cols-2 gap-2">
            <div>
              <p class="text-[11px] text-[#1d4ed8]">선택 전략</p>
              <p class="num text-[19px] font-bold tracking-[-0.02em]">{pct(metrics.cagrStrategy, 2)}</p>
            </div>
            <div class="border-l border-[#e2e8f0] pl-2.5">
              <p class="text-[11px] text-[#56667c]">비교지수 · {scenario.benchmark}</p>
              <p class="num text-[19px] font-bold tracking-[-0.02em]">{pct(metrics.cagrBenchmark, 2)}</p>
            </div>
          </div>
        </div>
        <div class="rounded-[10px] border border-[#e2e8f0] p-3">
          <div class="flex items-center justify-between gap-2">
            <p class="text-[12px] font-semibold">최대낙폭(MDD)</p>
            <span class="pill text-[11px] text-warn">주의</span>
          </div>
          <p class="num mt-1 text-[19px] font-bold tracking-[-0.02em]">{pct(metrics.mddStrategy, 2)}</p>
          <p class="num text-[11px] text-[#56667c]">
            허용 손실 {pctPlain(metrics.lossTolerance, 0)}보다 큽니다 · {scenario.benchmark} {pct(metrics.mddBenchmark, 2)}
          </p>
        </div>
      </div>
    </div>
  </div>

  {
    showHoldings && (
      <div class="app-card mt-3 px-3.5 py-3">
        <p class="text-[13px] font-bold">종목 구성 · {scenario.holdings.length}종목</p>
        <div class="mt-2.5 flex h-2.5 gap-[2px] overflow-hidden rounded-full" aria-hidden="true">
          {scenario.holdings.map((h) => (
            <span style={`width:${h.weight * 100}%;background:${h.color}`} />
          ))}
        </div>
        <ul class="mt-2.5 flex flex-wrap gap-x-4 gap-y-1 text-[11.5px]">
          {scenario.holdings.map((h) => (
            <li class="inline-flex items-center gap-1.5">
              <span class="h-2 w-2 rounded-full" style={`background:${h.color}`} />
              <span class="font-medium">{h.name}</span>
              <span class="num text-[#56667c]">{(h.weight * 100).toFixed(1)}%</span>
            </li>
          ))}
        </ul>
      </div>
    )
  }
</div>

<style>
  @container (min-width: 520px) {
    .ro-head {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }
    .ro-strip {
      grid-template-columns: repeat(4, minmax(0, auto));
      justify-content: space-between;
    }
  }
  @container (min-width: 700px) {
    .ro {
      padding: 22px 26px 26px;
    }
    .ro-perf {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
      align-items: start;
    }
  }
</style>
