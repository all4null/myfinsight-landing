---
/** 홈 화면 재현 (앱 home/HomeScreen.tsx 의 실제 문구) */
import { scenario } from "../../data/example";
const examples = [
  "미국 반도체 기업 중 실적이 좋은 곳에 나눠 투자하고 싶어요.",
  "배당을 꾸준히 주는 한국 대형주로 모으고 싶어요.",
];
---

<div class="scr px-4 py-5 text-[#0f172a]">
  <p class="text-[11px] font-bold tracking-[0.08em] text-[#1d4ed8]">개인화 투자전략</p>
  <p class="mt-1 text-[19px] leading-snug font-bold tracking-[-0.02em]">투자 아이디어를 포트폴리오로 확인해보세요.</p>
  <p class="mt-1.5 text-[12px] leading-relaxed text-[#475569]">
    내 투자조건을 반영해 종목을 고르고, 과거 데이터로 성과와 위험을 검증합니다.
  </p>
  <div class="app-card mt-4 p-3">
    <p class="min-h-[64px] text-[13px] leading-relaxed">{scenario.idea}<span class="caret" aria-hidden="true"></span></p>
    <div class="mt-2 flex items-center justify-between gap-2 border-t border-[#e2e8f0] pt-2.5" aria-hidden="true">
      <span class="rounded-lg border border-[#cbd5e1] px-2.5 py-1 text-[11.5px] font-semibold text-[#334155]">상세 조건</span>
      <span class="rounded-lg bg-[#1d4ed8] px-3 py-1.5 text-[12px] font-semibold text-white">투자조건 확인하기 ›</span>
    </div>
  </div>
  <ul class="mt-3 flex flex-col gap-1.5 text-[11.5px] text-[#475569]">
    {examples.map((e) => <li class="rounded-lg bg-white px-2.5 py-1.5 ring-1 ring-[#e2e8f0]">{e}</li>)}
  </ul>
  <div class="app-card mt-3 grid grid-cols-3 gap-2 px-3 py-2.5 text-[11.5px]">
    <p class="col-span-3 text-[12px] font-bold">저장된 기본 투자조건</p>
    <div><p class="text-[#56667c]">금액</p><p class="num font-semibold">2,000만 원</p></div>
    <div><p class="text-[#56667c]">기간</p><p class="font-semibold">3년</p></div>
    <div><p class="text-[#56667c]">성향</p><p class="font-semibold">위험중립형</p></div>
  </div>
</div>

<style>
  .caret {
    display: inline-block;
    width: 1.5px;
    height: 1.05em;
    margin-left: 2px;
    vertical-align: -0.15em;
    background: #1d4ed8;
  }
  @container (min-width: 600px) {
    .scr {
      padding: 26px 30px;
    }
  }
</style>
