---
/**
 * "리포트 보는 법 둘러보기"용 리포트 화면 재현 (앱 report/Dashboard.tsx 개요 탭 + tutorial/steps.ts 의 data-tour 대상).
 * data-tour 값은 앱과 같다: verdict, past, term-help, glossary, composition, allocation-list, details, paper-start.
 */
import LineChart from "./LineChart.astro";
import { scenario, metrics, pct, pctPlain } from "../../data/example";

const budget = 20_000_000;
const won = (v: number) => `₩${Math.round(v).toLocaleString("ko-KR")}`;
const sections = ["종합 판단", "포트폴리오 구성", "기업별 근거", "시장·뉴스 분석", "과거 성과", "요청 내역", "주의 사항과 전제", "자료와 분석 조건"];
const tabs = ["개요", "종목 선정", "과거 성과", "시장·뉴스", "요청·주의·자료"];
---

<div class="tr px-4 pt-4 pb-6 text-[#0f172a]">
  <div class="tr-head flex flex-col gap-3">
    <div class="min-w-0">
      <p class="text-[11px] font-bold tracking-[0.08em] text-[#1d4ed8]">분석 리포트</p>
      <p class="mt-1 text-[19px] leading-snug font-bold tracking-[-0.02em]">{scenario.name}</p>
    </div>
    <div class="flex gap-1.5" aria-hidden="true">
      <span class="rounded-lg bg-[#1d4ed8] px-3 py-1.5 text-[12px] font-semibold text-white" data-tour="paper-start">모의투자 시작</span>
      <span class="rounded-lg border border-[#cbd5e1] bg-white px-3 py-1.5 text-[12px] font-semibold text-[#1d4ed8]">조건 수정 요청</span>
    </div>
  </div>

  <div class="mt-3 flex items-end justify-between gap-3 border-b border-[#e2e8f0]">
    <div class="flex gap-4 overflow-hidden text-[12.5px] whitespace-nowrap" aria-hidden="true">
      {tabs.map((t, i) => <span class:list={["pb-2", i === 0 ? "border-b-2 border-[#1d4ed8] font-semibold text-[#1d4ed8]" : "text-[#475569]"]}>{t}</span>)}
    </div>
    <span class="tr-glossary mb-1.5 hidden shrink-0 rounded-lg border border-[#e2e8f0] bg-white px-2.5 py-1 text-[11.5px] font-semibold text-[#334155]" data-tour="glossary">투자 용어 설명</span>
  </div>

  <div class="app-card mt-3 flex flex-wrap items-center justify-between gap-x-6 gap-y-2 px-3.5 py-2.5 text-[11.5px]" data-tour="verdict">
    <div>
      <p class="text-[#56667c]">선택된 전략</p>
      <p class="font-semibold">{scenario.strategy}</p>
    </div>
    <div>
      <p class="text-[#56667c]">분석 기준일</p>
      <p class="num">{scenario.asOf}</p>
    </div>
    <div class="tr-period">
      <p class="text-[#56667c]">백테스트 기간</p>
      <p class="num">{scenario.period}</p>
    </div>
    <span class="font-semibold text-[#1d4ed8]">선택 이유 ›</span>
  </div>

  <div class="app-card mt-3 overflow-hidden" data-tour="past">
    <p class="border-b border-[#e2e8f0] bg-[#f8fafc] px-3.5 py-2 text-[13px] font-bold">백테스트 핵심 성과</p>
    <div class="tr-perf grid gap-3 p-3.5">
      <div class="min-w-0">
        <p class="mb-2 text-[12px] font-semibold">누적 수익률</p>
        <LineChart height={130} />
      </div>
      <div class="flex flex-col gap-2.5">
        <div class="rounded-[10px] border border-[#e2e8f0] p-3">
          <p class="text-[12px] font-semibold">연평균 수익률(CAGR)</p>
          <div class="mt-1.5 grid grid-cols-2 gap-2">
            <div>
              <p class="text-[11px] text-[#1d4ed8]">선택 전략</p>
              <p class="num text-[18px] font-bold">{pct(metrics.cagrStrategy, 2)}</p>
            </div>
            <div class="border-l border-[#e2e8f0] pl-2.5">
              <p class="text-[11px] text-[#56667c]">비교지수 · {scenario.benchmark}</p>
              <p class="num text-[18px] font-bold">{pct(metrics.cagrBenchmark, 2)}</p>
            </div>
          </div>
        </div>
        <div class="relative rounded-[10px] border border-[#e2e8f0] p-3">
          <p class="flex items-center gap-1 text-[12px] font-semibold">
            최대낙폭(MDD)
            <span class="tr-help relative inline-flex" data-tour="term-help">
              <span class="grid h-4 w-4 place-items-center rounded-full border border-[#94a3b8] text-[10px] leading-none text-[#56667c]" aria-hidden="true">?</span>
              <span class="tr-tip" role="note">
                기간 중 가장 높았던 평가금액에서 가장 크게 떨어진 비율입니다. 같은 기간 비교지수와 함께 봅니다.
              </span>
            </span>
          </p>
          <p class="num mt-1 text-[18px] font-bold">{pct(metrics.mddStrategy, 2)}</p>
          <p class="num text-[11px] text-[#56667c]">허용 손실 {pctPlain(metrics.lossTolerance, 0)} · {scenario.benchmark} {pct(metrics.mddBenchmark, 2)}</p>
        </div>
      </div>
    </div>
  </div>

  <div class="app-card mt-3 px-3.5 py-3" data-tour="composition">
    <p class="text-[13px] font-bold">종목 구성 · {scenario.holdings.length}종목</p>
    <div class="mt-2.5 flex h-2.5 gap-[2px] overflow-hidden rounded-full" aria-hidden="true">
      {scenario.holdings.map((h) => <span style={`width:${h.weight * 100}%;background:${h.color}`} />)}
    </div>
    <ul class="mt-2.5 flex flex-wrap gap-x-4 gap-y-1 text-[11.5px]">
      {
        scenario.holdings.map((h) => (
          <li class="inline-flex items-center gap-1.5">
            <span class="h-2 w-2 rounded-full" style={`background:${h.color}`} />
            <span class="font-medium">{h.name}</span>
            <span class="num text-[#56667c]">{(h.weight * 100).toFixed(1)}%</span>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="app-card mt-3 overflow-hidden" data-tour="allocation-list">
    <div class="flex items-baseline justify-between border-b border-[#e2e8f0] bg-[#f8fafc] px-3.5 py-2">
      <p class="text-[13px] font-bold">종목별 투자 금액</p>
      <p class="num text-[11px] text-[#56667c]">투자 기준금액 {won(budget)}</p>
    </div>
    <table class="w-full border-collapse text-left text-[11.5px]">
      <caption class="sr-only">예시 종목별 투자 금액</caption>
      <thead class="text-[#56667c]">
        <tr>
          <th scope="col" class="px-3.5 py-1.5 font-semibold">종목</th>
          <th scope="col" class="px-3.5 py-1.5 text-right font-semibold">비중</th>
          <th scope="col" class="px-3.5 py-1.5 text-right font-semibold">목표 배분액</th>
        </tr>
      </thead>
      <tbody>
        {
          scenario.holdings.map((h) => (
            <tr class="border-t border-[#eef2f6]">
              <th scope="row" class="px-3.5 py-1.5 font-medium">
                {h.name} <span class="text-[#56667c]">{h.ticker}</span>
              </th>
              <td class="num px-3.5 py-1.5 text-right">{(h.weight * 100).toFixed(1)}%</td>
              <td class="num px-3.5 py-1.5 text-right font-semibold">{won(budget * h.weight)}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <div class="app-card mt-3 overflow-hidden" data-tour="details">
    <div class="flex items-center justify-between border-b border-[#e2e8f0] bg-[#f8fafc] px-3.5 py-2">
      <p class="text-[13px] font-bold">자세한 분석</p>
      <span class="text-[11.5px] font-semibold text-[#1d4ed8]" aria-hidden="true">모두 펼치기</span>
    </div>
    <ul class="text-[12px]">
      {
        sections.map((s) => (
          <li class="flex items-center justify-between border-t border-[#eef2f6] px-3.5 py-2 first:border-t-0">
            <span class="font-medium">{s}</span>
            <span class="text-[#94a3b8]" aria-hidden="true">펼치기</span>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  .tr-tip {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 8px);
    z-index: 2;
    width: 220px;
    transform: translate(-50%, 4px);
    padding: 8px 10px;
    border-radius: 8px;
    background: #0f172a;
    color: #fff;
    font-size: 11.5px;
    font-weight: 400;
    line-height: 1.5;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 200ms ease,
      transform 200ms ease,
      visibility 0s linear 200ms;
  }
  .tr-help[data-open] .tr-tip {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
    transition:
      opacity 200ms ease,
      transform 200ms ease;
  }
  @container (min-width: 520px) {
    .tr-head {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }
    .tr-glossary {
      display: inline-flex;
    }
  }
  @container (min-width: 640px) {
    .tr {
      padding: 22px 26px 28px;
    }
    .tr-perf {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
      align-items: start;
    }
  }
  @container (max-width: 420px) {
    .tr-period {
      display: none;
    }
  }
</style>
