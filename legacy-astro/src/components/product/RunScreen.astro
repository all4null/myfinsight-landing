---
/**
 * 분석 진행 화면 재현 (앱 run/RunScreen.tsx · steps.ts 의 5묶음 14단계).
 * data-run 이 붙은 목록은 탭이 열릴 때 한 번 단계별로 완료 표시가 진행된다(스크립트: Flow.astro).
 * 스크립트가 없거나 동작 줄이기 설정이면 완료된 상태를 그대로 보여 준다.
 */
import { runGroups } from "../../data/example";
const total = runGroups.reduce((n, g) => n + g.detail, 0);
---

<div class="scr px-4 py-5 text-[#0f172a]">
  <p class="text-[11px] font-bold tracking-[0.08em] text-[#1d4ed8]">분석 진행</p>
  <p class="mt-1 text-[19px] leading-snug font-bold tracking-[-0.02em]" data-run-title>분석이 끝났습니다</p>
  <p class="mt-1.5 text-[11.5px] leading-relaxed text-[#475569]">브라우저를 닫아도 서버 실행은 계속됩니다.</p>

  <div class="app-card mt-3 p-3">
    <div class="flex items-baseline justify-between gap-2">
      <p class="text-[12.5px] font-bold">진행 단계</p>
      <p class="num text-[11px] text-[#56667c]">
        전체 {total}단계 중 <span data-run-count>{total}</span>단계 완료
      </p>
    </div>
    <ol class="mt-2.5 flex flex-col gap-1.5" data-run>
      {
        runGroups.map((g) => (
          <li class="run-row flex items-center gap-2.5 rounded-lg border border-[#e2e8f0] px-2.5 py-2 text-[12px]" data-state="done" data-detail={g.detail}>
            <span class="run-dot grid h-4 w-4 shrink-0 place-items-center rounded-full border" aria-hidden="true">
              <svg viewBox="0 0 12 12" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M2.5 6.2 5 8.5l4.5-5" />
              </svg>
            </span>
            <span class="min-w-0 flex-1 font-medium">{g.name}</span>
            <span class="run-state shrink-0 text-[11px]">완료</span>
          </li>
        ))
      }
    </ol>
  </div>

  <div class="mt-3 flex justify-end" aria-hidden="true">
    <span class="rounded-lg bg-[#1d4ed8] px-3.5 py-1.5 text-[12px] font-semibold text-white" data-run-cta>리포트 보기</span>
  </div>
</div>

<style>
  .run-row .run-dot {
    border-color: #cbd5e1;
    color: transparent;
    transition:
      background-color 200ms ease,
      border-color 200ms ease,
      color 200ms ease;
  }
  .run-row .run-state {
    color: #56667c;
  }
  .run-row[data-state="done"] .run-dot {
    background: #15803d;
    border-color: #15803d;
    color: #fff;
  }
  .run-row[data-state="done"] .run-state {
    color: #15803d;
    font-weight: 600;
  }
  .run-row[data-state="active"] {
    border-color: #93c5fd;
    background: #f5f9ff;
  }
  .run-row[data-state="active"] .run-dot {
    border-color: #2563eb;
    border-top-color: transparent;
    animation: spin 0.9s linear infinite;
  }
  .run-row[data-state="active"] .run-state {
    color: #1d4ed8;
    font-weight: 600;
  }
  [data-run-cta][data-hidden="true"] {
    visibility: hidden;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  @container (min-width: 600px) {
    .scr {
      padding: 26px 30px;
    }
  }
</style>
